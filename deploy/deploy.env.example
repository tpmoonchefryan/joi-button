# Site-specific deployment values for deploy/deploy-k3s.sh.
#
# Copy to deploy/deploy.env (which .gitignore excludes) and fill in. This
# repository is public and deliberately contains no cluster hostnames, no
# addresses and no network topology of its own — a default here would publish
# somebody's internal naming to everyone who clones the repo, and would also give
# the script a plausible-looking wrong answer instead of a clear refusal.
#
# Anything already exported in your shell wins over this file: for every name
# the header of deploy/deploy-k3s.sh documents, a non-empty exported value is
# used and the line here is ignored. An exported EMPTY value does not count as
# set, so the value here stands.

# REQUIRED. ssh host alias (or user@host) of the k3s node. The script uses it for
# `ssh` and, during `import`, streams the image tar to `sudo k3s ctr images import`,
# which is why passwordless sudo is preflighted there.
REMOTE=

# REQUIRED for `apply`. The hostname the Ingress will serve. It replaces the
# `replace-me.invalid` placeholder in deploy/k8s/ingress.yaml on the way in; the
# file on disk is never edited. Clients must be able to resolve this name (LAN
# DNS, or a hosts entry) — nothing in this repository arranges that.
APP_HOST=

# Optional. The ingress controller's load-balancer address. Used only to print a
# DNS-independent `curl --resolve ...` line after a successful deploy. Leave empty
# and the script prints a port-forward recipe instead.
LB_ADDRESS=

# Optional overrides — see the header of deploy/deploy-k3s.sh for the full list.
# NAMESPACE=joi-button
# KUBECTL=sudo k3s kubectl
# IMAGE_REPO=ghcr.io/tpmoonchefryan/joi-button/web
# API_IMAGE_REPO=ghcr.io/tpmoonchefryan/joi-button/api
